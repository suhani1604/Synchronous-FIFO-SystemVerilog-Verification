
// Transaction

class transaction;

    rand bit wr_en;
    rand bit rd_en;
    rand bit [7:0] data_in;

    bit [7:0] data_out;


    constraint c1 {
        wr_en != rd_en;
    }


    function void display(string name);

        $display("----------------------");
        $display("%s",name);
        $display("wr_en = %0b",wr_en);
        $display("rd_en = %0b",rd_en);
        $display("data_in = %0h",data_in);
        $display("data_out = %0h",data_out);
        $display("----------------------");

    endfunction

endclass


