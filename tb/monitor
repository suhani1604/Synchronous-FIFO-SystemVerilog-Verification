
// Monitor

class monitor;

    virtual fifo_if vif;

    mailbox #(transaction) mon2scb;


    function new(virtual fifo_if vif,
                 mailbox #(transaction) mb);

        this.vif = vif;
        mon2scb = mb;

    endfunction



    task run();

        transaction tr;


        forever begin

            @(posedge vif.clk);


            if(vif.rst==0) begin

                tr = new();


                tr.wr_en = vif.wr_en;
                tr.rd_en = vif.rd_en;

                tr.data_in = vif.data_in;
                tr.data_out = vif.data_out;


                mon2scb.put(tr);

                tr.display("MONITOR");

            end

        end

    endtask

endclass

