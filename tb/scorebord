

// Scoreboard

class scoreboard;

    mailbox #(transaction) mon2scb;

    bit [7:0] queue[$];


    function new(mailbox #(transaction) mb);

        mon2scb = mb;

    endfunction



    task run();

        transaction tr;


        forever begin

            mon2scb.get(tr);



            if(tr.wr_en) begin

                queue.push_back(tr.data_in);

                $display("SCB WRITE %h",tr.data_in);

            end



            if(tr.rd_en) begin


                if(queue.size()>0) begin


                    if(queue[0]==tr.data_out)

                        $display("SCB PASS");

                    else

                        $display("SCB FAIL Expected=%h Actual=%h",
                                  queue[0],tr.data_out);



                    queue.pop_front();

                end

            end


        end

    endtask

endclass




